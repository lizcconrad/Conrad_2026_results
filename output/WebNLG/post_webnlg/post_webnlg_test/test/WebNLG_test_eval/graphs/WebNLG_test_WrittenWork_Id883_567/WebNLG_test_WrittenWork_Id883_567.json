    "original_gold_lex_dicts": {
        "Id1": {
            "text": "George Allen & Unwin published the Fellowship of the Ring. The Fellowship of the Ring belongs to the fantasy literary genre and was followed by The Two Towers. The Fellowship author is J.R.R Tolkien, and it was released on July 29, 1954. But the Hobbit came before The Fellowship of the Ring."
        },
        "Id2": {
            "text": "The Fellowship of the Ring was a novel written by J.R.R. Tolkien that was released on July 29, 1954 and was published by George Allen & Unwin. The novel is in the fantasy genre and was preceded by the Hobbit and followed by The Two Towers."
        },
        "Id3": {
            "text": "Fellowship of the Ring, written by J.R.R. Tolkien, was published July 29, 1954 by George Allen & Unwin. The fantasy novel falls chronologically after The Hobbit, and before The Two Towers."
        }
