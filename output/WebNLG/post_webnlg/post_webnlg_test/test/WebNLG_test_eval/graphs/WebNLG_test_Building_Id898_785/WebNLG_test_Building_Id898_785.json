    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The College of William and Mary is the owner of the Alan B. Miller Hall at 101 Ukrop Way in Virginia, which was the design of Robert A.M. Stern. The building of the hall started on the 30th of March 2007 and completed on the 1st of June 2009. The Mason School of Business are the current tenants of the building."
        },
        "Id2": {
            "text": "The College of William and Mary is the owner of the Alan B. Miller Hall which is located in Virginia at 101 Ukrop Way. The Mason School of Business are the current tenants of the hall which was completed on 01/06/2009. The building was designed by Robert A.M. Stern and began construction on 30/03/2007."
        },
        "Id3": {
            "text": "The College of William and Mary is the owner of the Alan B. Miller Hall which is situated in Virginia at 101 Ukrop Way. The hall was completed on the 1st of June 2009 and began construction on the 30th of March 2007. The architect of the Alan B Miller Hall is Robert A M Stern and the current occupants are The Mason School of Business."
        }
