    "original_gold_lex_dicts": {
        "Id1": {
            "text": "Compilation album Expect a Miracle was produced by composer and pianist Brian Kelly following his earlier album Pools of Light. The album is an instrumental album with a total length of 54.56. Expect a Miracle was followed by Kelly\u2019s Afterplay album."
        },
        "Id2": {
            "text": "Brian Kelly, producer of the album Pools of Light, has a new instrumental compilation album called \"Expect A Miracle\" (runtime 54.56 minutes). Kelly will also release the album 'Afterplay'."
        },
        "Id3": {
            "text": "Expect a Miracle a compilation album, created and produced by Brian Kelly with runtime 54:56 is of instrumental music genre. It was preceded by the Brian Kelly album Pools of Light and followed by Afterplay by Brian Kelly."
        }
    },
