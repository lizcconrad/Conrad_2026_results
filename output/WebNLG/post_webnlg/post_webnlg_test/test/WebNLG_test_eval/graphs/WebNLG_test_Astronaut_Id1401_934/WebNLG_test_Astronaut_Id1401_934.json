    "original_gold_lex_dicts": {
        "Id1": {
            "text": "Alan Shepard, an American, who went to school at NWC and graduated with an MA in 1957 and who was the Chief of the Astronaut Office in 1963, was born in New Hampshire on Nov 18, 1923 and died in California."
        },
        "Id2": {
            "text": "Alan Shepard was an American, born November 18th, 1923 in New Hampshire and he died in California. He graduated from NWC with an M.A. in 1957 and was the Chief of the Astronaut Office in 1963."
        },
        "Id3": {
            "text": "Alan Shepard is a US national who was born in New Hampshire in November of 1923 and died in California. He graduated from NWC with an MA in the year 1957 and subsequently served as Chief of the Astronaut Office from 1963."
        }
