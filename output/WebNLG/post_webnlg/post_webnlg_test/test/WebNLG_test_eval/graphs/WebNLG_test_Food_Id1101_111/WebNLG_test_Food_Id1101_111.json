    "original_gold_lex_dicts": {
        "Id1": {
            "text": "Mexicans are people from Mexico, which is a country from the Guadalajara region that is led by Silvano Aureoles Conejo. The Mexican peso is the currency used to buy such dishes as Bionico, a dessert found in Mexico that contains raisins,."
        },
        "Id2": {
            "text": "Bionico is a dessert containing raisins that can be found in Guadalajara, Mexico, which is inhabited by Mexicans and uses pesos as their currency and is led by Silvano Aureoles Conejo."
        },
