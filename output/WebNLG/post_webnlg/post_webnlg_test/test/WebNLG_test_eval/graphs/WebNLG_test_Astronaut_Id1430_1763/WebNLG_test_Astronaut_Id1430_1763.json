    "original_gold_lex_dicts": {
        "Id1": {
            "text": "Alan Shepard was an American who was born on November 18, 1923 in New Hampshire, was awarded the Distinguished Service Medal by the United States Navy,selected by NASA, served as Chief of the Astronaut Office in 1963 and died in California."
        },
        "Id2": {
            "text": "Alan Shepard was an American, born on November 18, 1923 in New Hampshire. He was selected by NASA in 1959, and was the Chief of the Astronaut Office in 1963. The United States Navy awarded him the Distinguished Service Medal. He died in California."
        },
        "Id3": {
            "text": "American Astronaut Alan Shepard was born in New Hampshire on November 18, 1923. He was chosen by NASA in 1959 and became Chief of the Astronaut Office in 1963. He was awarded the Distinguished Service Medal by the US Navy. Shepard died in California."
        }
