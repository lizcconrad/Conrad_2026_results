    "original_gold_lex_dicts": {
        "Id1": {
            "text": "After releasing their album Squeeze, music group the Velvet Underground produced and released rock music album Bootleg Series Volume 1: The Quine Tapes, which they recorded in St Louis Missouri, USA The album was released on 2001-10-16 under the Polydor and Universal Music Group record labels and has a total run time of 230:05 minutes."
        },
        "Id2": {
            "text": "Bootleg Series Volume 1: The Quine Tapes with run time of 230:05 was recorded under the Polydor Records and Universal Music Group record label in St. Louis, Missouri, United States and released on October, 16, 2001. It was preceded by Squeeze by The Velvet Underground."
        },
        "Id3": {
            "text": "The Bootleg Series Volume I: The Quine Tapes with runtime of 230.05 minutes was recorded in St. Louis Missouri,United States and released on 10-16-2001. Recorded through Polydor Records and Universal Music Group record label the album was preceded by the album Squeeze."
        }
