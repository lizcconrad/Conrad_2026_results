    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The Bootleg Series Volume 1: The Quine Tapes was recorded under the Universal Music Group record label in San Francisco and released by the record label Polydor Records. It was preceded by the album Squeeze."
        },
        "Id2": {
            "text": "Recorded in San Francisco, The Bootleg Series Volume 1: The Quine Tapes can be found under the record label of Universal Music Group even though the series was recorded under the Polydor Records record label. The Velvet Underground's triple album, The Bootleg Series Volume 1: The Quine Tapes was preceded by their album, Squeeze."
        },
        "Id3": {
            "text": "The Bootleg Series Volume I: The Quine Tapes was recorded in San Francisco through Polydor Records and released by Universal Music Group. The previous Velvet Underground album was titled Squeeze."
        }
    },
