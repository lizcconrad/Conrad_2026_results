    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The Mason School of Business are the current tenants of Alan B Miller Hall (located in Virginia, United States). The college of William and Mary is the owner. The Hall building start date was in 30th March 2007, designed by Robert A.M. Stern. The address of the Hall is \"101 Ukrop Way\"."
        },
        "Id2": {
            "text": "The architect of the Alan B Miller Hall at 101 Ukrop Way in Virginia, USA, is Robert A M Stern. The current occupants of the hall, which is owned by The College of William and Mary, are The Mason School of Business and it began construction on the 30th of March, 2007."
        },
        "Id3": {
            "text": "The Alan B Miller Hall is located in Virginia in the USA at 101 Ukrop Way. The College of William and Mary currently own the hall which began construction on 30/03/2007 and was designed by Robert A.M. Stern. The Mason School of Business are the current tenants."
        }
    },
