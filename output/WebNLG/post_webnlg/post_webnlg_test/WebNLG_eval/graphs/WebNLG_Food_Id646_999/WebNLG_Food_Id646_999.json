    "original_gold_lex_dicts": {
        "Id1": {
            "text": "Sandesh is a dessert, as is Bionico which contains granola and is from the Guadalajara region of Mexico. Mexico uses pesos as their currency and the people that live there are Mexicans."
        },
        "Id2": {
            "text": "Sandesh and Bionico are desserts, the latter one found in Guadalajara, Mexico, and requires granola as an ingredient. Mexico is a country where Mexicans live and where that dessert can be purchased using the country currency, the peso."
        },
        "Id3": {
            "text": "The people in Mexico are called Mexicans and the currency is the peso. Bionico is a dessert food found in Mexico in the Guadalajara area. This dish requires granola as one of its ingredients. Another types of dessert is Sandesh."
        }
    },
