    "original_gold_lex_dicts": {
        "Id1": {
            "text": "Est\u00e1dio Municipal Coaracy da Mata Fonseca is a stadium in Arapiraca. It is the home ground of Agremia\u00e7\u00e3o Sportiva Arapiraquense of the Brazilian Championship Series C where the champions are Vila Nova Futebol Clube. The Brazilian name for the championship is Campeonato Brasileiro S\u00e9rie C, and Agremia\u00e7\u00e3o Sportiva Arapiraquense competed there in 2015. The club has 17,000 members."
        }
    },
