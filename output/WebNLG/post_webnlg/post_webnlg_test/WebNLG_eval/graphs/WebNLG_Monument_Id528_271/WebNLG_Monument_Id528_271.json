    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The 11th Mississippi Infantry Monument is in the United States and is categorised as a contributing property. The monument was erected in 2000, and it is located in Adams County, Pennsylvania. Pennsylvania's Franklin County is found to the west of Adams County, while Carroll County Maryland is southeast of Adams County Pennsylvania, which has Cumberland County to the north."
        },
        "Id2": {
            "text": "The 11th Mississippi Infantry Monument in Adams County, Pennsylvania is categorized as a Contributing Property, was established in 2000, and is in the United States. Adams County, Pennsylvania has Carroll County, Maryland to its southeast, Cumberland county, Pennsylvania to its north, and Franklin County, Pennsylvania to its west."
        },
        "Id3": {
            "text": "The 11th Mississippi Infantry Monument falls under the category of Contributing property and was established in the year 2000 located in Adams County, Pennsylvania in the United States. Adams County Pennsylvania is East of Franklin County, Pennsylvania to the southeast lies Carroll County, Maryland and Cumberland County, Pennsylvania to its north."
        }
