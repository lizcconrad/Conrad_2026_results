    "original_gold_lex_dicts": {
        "Id1": {
            "text": "Alan Shepard was a United States national, born on November 18th, 1923 in New Hampshire. He was the Chief of the Astronaut Office in 1963. The United States Navy awarded him the Distinguished Service Medal, which is higher than the Department of Commerce gold medal. He died in California."
        },
        "Id2": {
            "text": "American Alan Shepard was born in New Hampshire on November 18th 1923. Shepard was awarded the Distinguished Service Medal from the Navy which ranks higher than Department of Commerce Gold Medal, he was the chief of the astronaut office in 1963 and he recently passed away in California."
        },
        "Id3": {
            "text": "Alan Shepard, who served as Chief of the Astronaut Office in 1963, was awarded the Distinguished Service Medal, which is higher than the Department of Commerce Gold Medal, by the United States Navy. Shepard was born in New Hampshire in the United States on November 18, 1923 and died in California."
        }
    },
