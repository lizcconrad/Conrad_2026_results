    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The construction of Alan B. Miller Hall started on March 30th, 2007. Robert A. M. Stern is the architect of the building. Alan B. Miller Hall is located at 101 Ukrop Way, Virginia, and the current tenant is the Mason School of Business. The College of William and Mary owns the Hall."
        },
        "Id2": {
            "text": "The construction of Alan B. Miller Hall began on March 30th, 2007. Robert A. M. Stern designed the building. Alan B. Miller Hall is located at 101 Ukrop Way, Virginia,and is owned by the College of William and Mary. The current tenant is the Mason School of Business."
        },
        "Id3": {
            "text": "The College of William and Mary is the owner of the Alan B. Miller Hall at 101 Ukrop Way in Virginia. The building, which began construction on the 30th of March 2007, was designed by Robert A.M. Stern. The current occupants are The Mason School of Business."
