    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The full name of Agremia\u00e7\u00e3o Sportiva Arapiraquense is \"Agremia\u00e7\u00e3o Sportiva Arapiraquense\". They play in the Campeonato Brasileiro Serie C in 2015 based in Brazil on their ground called the Estadio Municipal Coaracy da Mata Fonseca located in Arapiraca. The Vila Nova Futebol Clube are the champions."
        },
        "Id2": {
            "text": "Agremia\u00e7\u00e3o Sportiva Arapiraquense has 17000 members and is playing the Campeonato Brasileiro S\u00e9rie C from Brazil (champions: Vila Nova Futebol Clube). They also competed there in 2015. Their home ground is the Estadio Municipal Coaracy da Mata Fonseca located in Arapiraca."
        },
        "Id3": {
            "text": "Agremia\u00e7\u00e3o Sportiva Arapiraquense, a member of the Brazilian Campeonato Brasileiro S\u00e9rie C league, often plays on the grounds of Est\u00e1dio Municipal Coaracy da Mata Fonseca in Arapiraca against their rivals and fellow members of Campeonato Brasileiro S\u00e9rie C, Vila Nova Futebol Clube, the champions of the league. The club also participated in the league in 2015."
        }
    },
