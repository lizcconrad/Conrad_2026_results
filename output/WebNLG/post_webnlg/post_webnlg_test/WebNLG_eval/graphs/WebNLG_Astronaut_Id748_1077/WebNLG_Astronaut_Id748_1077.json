    "original_gold_lex_dicts": {
        "Id1": {
            "text": "American Alan Shepard, who was the Chief of the Astronaut Office in 1963, and a member of the Apollo 14 crew, was awarded the Distinguished Service Medal in the United States Navy. He was born in New Hampshire on Nov 18, 1923 and died in California."
        },
        "Id2": {
            "text": "United States citizen, Alan Shepard, who was born in New Hampshire on November 18, 1923 and died in California, served as Chief of the Astronaut Office in 1963. He also served as a crew member of Apollo 14, and was awarded the Distinguished Service Medal by the United States Navy."
        },
        "Id3": {
            "text": "Apollo 14 crew man Alan Shepard is an American who was born in New Hampshire in 1923 and died in California. He was the Chief of the Astronaut Office in 1963 and was awarded the Distinguished Service Medal by the US Navy."
        }
