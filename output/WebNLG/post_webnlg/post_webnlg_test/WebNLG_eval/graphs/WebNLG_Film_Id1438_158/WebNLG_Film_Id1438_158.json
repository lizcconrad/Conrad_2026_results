    "original_gold_lex_dicts": {
        "Id1": {
            "text": "Harry Carey, born in 1878, wrote, directed and acted in the film McVeagh of the South Seas which was produced by the Progressive Motion Picture Company. Cyril Bruce also directed the movie which was distributed by Alliance Films Corporation."
        },
        "Id2": {
            "text": "Harry Carey, born in 1878, wrote and directed McVeagh of the South Seas. Cyril Bruce was also a director, while the movie was produced by the Progressive Motion Picture Company and distributed by Alliance Films Corporation."
        },
        "Id3": {
            "text": "Cyril Bruce and the actor Harry Carey, the latter also being the author, both born in 1878, directed the movie \" McVeagh of the South Seas\" which was produced by the Progressive Motion Picture Company and distributed by Alliance Films Corporation."
        }
