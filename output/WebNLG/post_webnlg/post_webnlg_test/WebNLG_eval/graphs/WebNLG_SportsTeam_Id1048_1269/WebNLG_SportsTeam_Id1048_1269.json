    "original_gold_lex_dicts": {
        "Id1": {
            "text": "\"Agremia\u00e7\u00e3o Sportiva Arapiraquense\" is the full name of the Agremia\u00e7\u00e3o Sportiva Arapiraquense club, which has 17000 members. They play in the Campeonato Brasileiro S\u00e9rie C league on their ground Estadio Municipal Coaracy da Mata Fonseca located in Arapiraca. The championship is based in Brazil and Vila Nova Futebol Clube are the champions."
        },
        "Id2": {
            "text": "Est\u00e1dio Municipal Coaracy da Mata Fonseca is located in Arapiraca and is the name of the ground of Agremia\u00e7\u00e3o Sportiva Arapiraquense (full name \"Agremia\u00e7\u00e3o Sportiva Arapiraquense\"). The club has 17000 members and competes in the Brazilian Campeonato Brasileiro S\u00e9rie C, which the team Vila Nova Futebol Clube have been champions of."
        }
    },
