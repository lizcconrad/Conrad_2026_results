    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The Agremia\u00e7\u00e3o Sportiva Arapiraquense club are managed by Vica. They have 17000 members and played in the Campeonato Brasileiro S\u00e9rie C league based in Brazil on their ground the Estadio Municipal Coaracy da Mata Fonseca located in Arapiraca. The Vila Nova Futebol Clube are the champions."
        },
        "Id2": {
            "text": "The Estadio Municipal Coaracy da Mata Fonseca is in Arapiraca & is the name of the ground of Agremia\u00e7\u00e3o Sportiva Arapiraquense (plays in the Campeonato Brasileiro S\u00e9rie C league managed by Vica with 17000 members). The Vila Nova Futebol Clube from Brazil were champions at the Campeonato Brasileiro S\u00e9rie C."
        },
        "Id3": {
            "text": "Agremia\u00e7\u00e3o Sportiva Arapiraquense has 17000 members and played in the Campeonato Brasileiro S\u00e9rie C league from Brazil, whose champions are Vila Nova Futebol Clube. They are managed by Vica. The Est\u00e1dio Municipal Coaracy da Mata Fonseca is the name of the ground of Agremia\u00e7\u00e3o Sportiva Arapiraquense located in Arapiraca."
        }
    },
