    "original_gold_lex_dicts": {
        "Id1": {
            "text": "Alan Shepard is an American who was born on November 18, 1923 in New Hampshire, went to school at NWC and graduated with an MA in 1957, was selected by NASA in 1959, was the Chief of the Astronaut Office in 1963 and died in California."
        },
        "Id2": {
            "text": "Alan Shepard, a United States native, who served as Chief of the Astronaut Office in 1963, graduated from NWC in 1957 with an M.A. He was selected by NASA in 1959. Shepard was born in New Hampshire on November 18, 1923 and died in California."
        },
        "Id3": {
            "text": "Alan Shepard was born on November 18th, 1923, in New Hampshire. His nationality is American. He graduated from NWC with an M.A in 1957. NASA selected him in 1959, and he was the chief of Astronaut office in 1963. He died in California."
        }
