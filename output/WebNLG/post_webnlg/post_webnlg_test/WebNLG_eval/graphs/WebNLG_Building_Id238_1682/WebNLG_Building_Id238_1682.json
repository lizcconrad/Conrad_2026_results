    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The Alan B Miller Hall, which is built in a Georgian style, is located in Virginia and is owned by The College of William and Mary. The building is currently occupied by The Mason School of Business and can be found at 101 Ukrop Way. It was designed by Robert A.M. Stern and began construction on the 30th of March 2007."
        },
        "Id2": {
            "text": "The address of the Robert A M Stern designed building, the Alan B. Miller Hall, is 101 Ukrop Way in Virginia. They started to build the Georgian style hall on 30/03/2007 and it is now owned by The College of William and Mary with the current tenants being The Mason School of Business."
        },
        "Id3": {
            "text": "The Alan B. Miller Hall at 101 Ukrop Way, Virginia, was designed in the Georgian style by Robert A.M. Stern. The College of William and Mary is the owner of the building which started construction on 30/03/2007. It currently houses The Mason School of Business."
        }
    },
