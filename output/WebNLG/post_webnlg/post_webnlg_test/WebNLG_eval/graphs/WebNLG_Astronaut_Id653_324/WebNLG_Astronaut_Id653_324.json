    "original_gold_lex_dicts": {
        "Id1": {
            "text": "Prior to his death in California, Alan Shepard was born on November 18, 1923 in New Hampshire, United States. He served as Chief of the Astronaut Office in 1963 and was awarded the Distinguished Service Medal by the United States Navy."
        },
        "Id2": {
            "text": "American Alan Shepard was born in New Hampshire on November 18th 1923. Shepard was awarded the Distinguished Service Medal from the Navy, he was the chief of the astronaut office in 1963 and he recently passed away in California."
        },
        "Id3": {
            "text": "Alan Shepard (nationality: United States) was born November 18th, 1923 in New Hampshire. He was the chief of the Astronaut office in 1963. The United States Navy awarded the Distinguished service medal to him. He died in California."
        }
    },
