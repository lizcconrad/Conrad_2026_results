    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The architect of Alan B Miller Hall, owned by The College of William and Mary, is Robert A M Stern and it is situated at 101 Ukrop Way, Virginia, USA. They started to build the Alan B Miller Hall on the 30th of March, 2007 and The Mason School of Business are now its tenants."
        },
        "Id2": {
            "text": "The address of the Alan B. Miller Hall is \"101 Ukrop Way\" in Virginia, USA and it currently houses The Mason School of Business. The College of William and Mary is the owner of the Robert A.M. Stern designed hall which began construction on 30/03/2007."
        },
        "Id3": {
            "text": "The Alan B Miller Hall is located in Virginia, USA at 101 Ukrop Way and was designed by Robert A.M. Stern while being owned by The College of William and Mary. The building began construction on 30/03/2007 and is now occupied by The Mason School of Business."
        }
    },
