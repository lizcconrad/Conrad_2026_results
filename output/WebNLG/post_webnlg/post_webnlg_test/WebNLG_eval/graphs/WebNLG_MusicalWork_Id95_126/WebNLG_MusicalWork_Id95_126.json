    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The train song Mermaid, released on Dec. 27th, 2012 and written by Amund Bjorklund and Espen Lind, was preceded by the song This'll Be My Year. Mermaid lasts 3.16 minutes."
        },
        "Id2": {
            "text": "Train released their song Mermaid on December 27th, 2012. The song was written by Amund Bjorklund and Espen Lind, and runs three minutes and sixteen seconds long. Train's most recent song before Mermaid was This'll Be My Year."
        },
        "Id3": {
            "text": "Mermaid by Train was written by Espen Lind and Amund Bjorklund. The song, which runs 3 minutes and 16 seconds long, was released on December 27th, 2012. Train's most recent song before Mermaid was This'll Be My Year."
        }
