    "original_gold_lex_dicts": {
        "Id1": {
            "text": "Alan Shepard, a United States citizen, who graduated from NWC with an M.A. in 1957, was the Chief of the Astronaut Office in 1963. Shepard was awarded the Distinguished Service Medal by the United States Navy. He was born on November 18th, 1923 in New Hampshire and died in California."
        },
        "Id2": {
            "text": "Alan Shepard was an American who was born on November 18, 1923 in New Hampshire, went to school at NWC and graduated with an MA in 1957, was the Chief of the Astronaut Office in 1963, was awarded the Distinguished Service Medal in the United States Navy and died in California."
        },
        "Id3": {
            "text": "Alan Shepard, a United States native, who graduated from NWC in 1957 with an M.A., served as Chief of the Astronaut Office in 1963, and was awarded the Distinguished Service Medal by the United States Navy. Shepard was born in New Hampshire on November 18, 1923 and died in California."
        }
    },
