        "Id1": {
            "text": "Alan Shepard was born in New Hampshire, U.S.A., on November 18, 1923. He served in the U.S. Navy and earned the Distinguished Service Medal. He died on July 12, 1998, in California."
        },
        "Id2": {
            "text": "The American Alan Shepard was born in New Hampshire on November 18th, 1923, and passed away on July 21st, 1998, in California. He was awarded the Distinguished Service Medal by the United States Navy."
        },
