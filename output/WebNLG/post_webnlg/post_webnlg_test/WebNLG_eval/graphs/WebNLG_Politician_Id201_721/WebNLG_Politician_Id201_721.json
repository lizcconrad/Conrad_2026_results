    "original_gold_lex_dicts": {
        "Id1": {
            "text": "Abraham A. Ribicoff\u2019s spouse was Ruth Ribicoff and he was an American citizen who was born in Connecticut. Abraham A. Ribicoff was in office while John F. Kennedy was president and preceded John N. Dempsey in the office."
        },
        "Id2": {
            "text": "Abraham A. Ribicoff\u2019s spouse was Ruth Ribicoff and his successor was John N. Dempsey. Abraham was in office during the John F. Kennedy presidency. Abraham A. Ribicoff was American and was born in Connecticut."
        },
        "Id3": {
            "text": "John N Dempsey succeeded American citizen Abraham A Ribicoff in his role. Abraham A. Ribicoff was born in Connecticut and therefore was an American citizen. His wife was Ruth Ribicoff and Abraham was in office at the same time that John F. Kennedy was president."
        }
