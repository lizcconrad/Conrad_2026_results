    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The Train song Mermaid, of the reggae genre, written by Espen Lind and Amund Bj\u00f8rklund with runtime of 3 minutes and 16 seconds was produced by the Espionage production team. It was followed with Imagine, a song by John Lennon."
        },
        "Id2": {
            "text": "The Train song Mermaid, which is an example of the reggae genre, was produced by the Espionage production team and released on 2012-12-27. It was written by band members Espen Lind and Amund Bj\u00f8rklund and was preceded by the song This'll be my year. The song has a total runtime of three minutes and sixteen seconds. The band followed this up with their own cover of John Lennon\u2019s Imagine."
        },
        "Id3": {
            "text": "The song Mermaid was performed by the musical band Train. It was written by band members Espen Lind and Amund Bjorklund in the reggae genre and has a total length of three minutes and sixteen seconds. The song was produced by the production team Espionage and the band followed it up with a cover of John Lennon\u2019s Imagine."
        }
