    "original_gold_lex_dicts": {
        "Id1": {
            "text": "Based in Arapiraca, the Estadio Municipal Coaracy da Mata Fonseca is the name of the ground in which Agremia\u00e7\u00e3o Sportiva Arapiraquense play. Agremia\u00e7\u00e3o Sportiva Arapiraquense has 17000 members and competed in the 2015 Campeonato Brasileiro S\u00e9rie C."
        },
        "Id2": {
            "text": "Agremia\u00e7\u00e3o Sportiva Arapiraquense's club has 17000 members and they play at the Estadio Municipal Coaracy da Mata Fonseca which is located in Arapiraca. The team plays in the Campeonato Brasileiro S\u00e9rie C league and played in the Campeonato Brasileiro Serie C in 2015."
        },
        "Id3": {
            "text": "Est\u00e1dio Municipal Coaracy da Mata Fonseca is the name of the ground of Agremia\u00e7\u00e3o Sportiva Arapiraquense in Arapiraca. Agremia\u00e7\u00e3o Sportiva Arapiraquense has 17000 members, competed in the 2015 Campeonato Brasileiro S\u00e9rie C, and played in the Campeonato Brasileiro S\u00e9rie C league."
