    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The album entitled Nord, followed by Year of No Light's album Live at Roadburn 2008, was released by the artist Year of No Light on the Crucial Blast label on the date 2006-09-06 and produced by Year of No Light."
        },
        "Id2": {
            "text": "The album Nord by Year of No Light was produced by the band and released by the record label Crucial blast on 06-09-2006. The album Nord was followed with the album Live at Roadburn 2008."
        },
        "Id3": {
            "text": "The album Nord by the Year of No Light, who also produced it was released on September 6, 2006 on record label Crucial Blast. Live at Roadburn 2008 was preceded by the album Nord."
        }
