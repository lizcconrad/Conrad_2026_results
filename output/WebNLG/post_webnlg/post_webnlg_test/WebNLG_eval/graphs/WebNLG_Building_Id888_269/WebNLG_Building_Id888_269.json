    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The Mason School of Business are the current tenants of Alan B Miller Hall which is a building in the Georgian architectural style. The building is owned by The College of William and Mary and was designed by Robert A.M. Stern. The address of the hall is 101 Ukrop Way and the construction start date was the 30th of March 2007."
        },
        "Id2": {
            "text": "The construction of Alan B. Miller Hall started on March 30th, 2007. Robert A. M. Stern is the architect of the building, which was built in the Georgian architecture style.. Alan B. Miller Hall is located at 101 Ukrop Way, and the current tenant is the Mason School of Business. The College of William and Mary owns the Hall."
        },
        "Id3": {
            "text": "Alan B. Miller Hall, owned by the College of William and Mary, started being built at 101 Ukrop Way on March 30, 2007 and used the Georgian-style design of architect Robert A M Stern. The building is occupied today by the Mason School of Business."
        }
    },
