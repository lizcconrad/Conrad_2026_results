    "original_gold_lex_dicts": {
        "Id1": {
            "text": "Alan Shepard was an American who was born on November 18, 1923 in New Hampshire, which is home to the purple finch. He was awarded the Distinguished Service Medal by the United States Navy and died in California."
        },
        "Id2": {
            "text": "The American Alan Shepard was born in New Hampshire in 1923 and died in California, having been awarded the Distinguished Service Medal whilst in the United States Navy. His native state boasts the Purple Finch as a local bird."
        },
        "Id3": {
            "text": "The nationality of Alan Shepard is American, and he was born on November 18th, 1923. His birthplace was New Hampshire, and he died in California. The purple finch is a native bird to New Hampshire. Shepard was awarded the distinguished service medal by the United states navy."
