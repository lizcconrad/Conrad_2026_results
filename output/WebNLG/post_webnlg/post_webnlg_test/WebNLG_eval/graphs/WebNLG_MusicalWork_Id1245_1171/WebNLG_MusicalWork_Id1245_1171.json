    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The song Mermaid by Train was written by Espen Lind and Amund Bjorklund and released on December 27, 2017. The song Mermaid is three minutes and sixteen seconds long. Mermaid is preceded by the song \"This'll Be My Year\" then after by John Lennon's \"Imagine\"."
        },
        "Id2": {
            "text": "The Train song Mermaid written by Amund Bj\u00f8rklund and Espen Lind with runtime of 3.16 minutes was released on 27th December 2012. It was preceded by the song This'll Be My Year and was followed by the release of Imagine by John Lennon performed by Train."
        },
        "Id3": {
            "text": "\"Mermaid\", which was the song elected by Train to follow \"This'll be my Year,\" is a 3 minutes and 16 seconds long musical piece written by the songwriting team of Amund Bjorklund and Espen Lind. After the December 27, 2012 release of Mermaid, Train followed up with a rendition of the iconic John Lennon song, \"Imagine.\""
        }
    },
