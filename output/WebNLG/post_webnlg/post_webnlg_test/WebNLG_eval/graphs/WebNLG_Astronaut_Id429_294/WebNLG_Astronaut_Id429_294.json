    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The American born Alan Shepard was a test pilot selected in 1959 by NASA, who was raised in New Hampshire. He was born in that state in November of 1923 and died in California."
        },
        "Id2": {
            "text": "Born in New Hampshire in November of 1923, US national Alan Shepard was a test pilot selected by NASA in 1959. He died in the American state of California."
        },
        "Id3": {
            "text": "Alan Shepard was born November 18, 1923, in New Hampshire, U.S.A. He served as a test pilot and was selected by NASA in 1959. Shepard died in California."
        }
    },
