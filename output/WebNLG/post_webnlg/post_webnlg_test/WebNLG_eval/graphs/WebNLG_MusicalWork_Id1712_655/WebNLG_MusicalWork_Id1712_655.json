    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The Train song Mermaid, which is an example of the reggae and pop rock genres, was produced by the Espionage production team and released on 2012-12-27. It was written by Espen Lind and was preceded by the song This'll be my year. The song has a total runtime of three minutes and sixteen seconds. The band followed this up with their cover of John Lennon\u2019s Imagine."
        },
        "Id2": {
            "text": "Train followed This'll Be My Year with with the release of Mermaid (3.16 minutes), a pop rock/reggae song produced by Espionage. Mermaid premiered on December 27, 2012, and was subsequently followed by the release of the band's cover of John Lennon's Imagine."
        },
        "Id3": {
            "text": "The Train song Mermaid, which is in the reggae and pop rock genres, was released on 2012-12-27 and produced by the Espionage production team. It was preceded by the song This'll be my year and was followed by the band\u2019s cover of Imagine by John Lennon. The song has a total runtime of three minutes and sixteen seconds."
        }
