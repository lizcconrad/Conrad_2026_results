    "original_gold_lex_dicts": {
        "Id1": {
            "text": "Released on September 6 of 2006 A Year of No Light's post-metal album,\" Nord,\" was followed up by \"Live at Roadburn 2008.\" Produced by the artist, The Year of No Light, the album, \"Nord\" is in the sludge metal genre."
        },
        "Id2": {
            "text": "The album, \"Nord\", a post-metal genre piece, also considered sludge metal, was produced and released by the artist Year of No light in 2006, on September, 6, and followed up the artist's album, \"Live at Roadburn 2008.\""
        },
        "Id3": {
            "text": "The album Nord created and produced by Year of No Light is in sludge metal and post metal genre. Nord was released on 06-09-2006 and was followed by the album Live at Roadburn in 2008."
        }
