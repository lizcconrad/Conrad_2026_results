    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The band Train followed up \"This'll be my year\" with a 3 minutes, 16 seconds long pop rock song, entitled \"Mermaid.\" Mermaid, which is also considered an example of the reggae genre of music, was written by songwriter, Espen Lind and released on December, 27, 2012."
        },
        "Id2": {
            "text": "The Train song Mermaid, which is an example of the reggae and pop rock genres, was released on 2012-12-27. It was written by Espen Lind and was preceded by the song This'll be my year. The song has a total runtime of three minutes and sixteen seconds."
        },
        "Id3": {
            "text": "The Train song by mermaid is written by Espen Lind. It lasts a total of 3.16 minutes and is from the pop rock and reggae genre. The song was released on December 27th, 2012 and is preceded by the song This'll Be My Year."
        }
