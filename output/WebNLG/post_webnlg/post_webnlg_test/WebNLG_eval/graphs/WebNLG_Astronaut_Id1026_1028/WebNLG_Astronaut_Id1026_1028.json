    "original_gold_lex_dicts": {
        "Id1": {
            "text": "Alan Shepard is an American who was born on November 18th, 1923 in New Hampshire, graduated from NWC with an M.A. in 1957, was the Chief of the Astronaut Office in 1963 and died in California."
        },
        "Id2": {
            "text": "Alan Shepard was born in New Hampshire on Nov 18, 1923. He graduated from NWC with an MA in 1957, quickly rising through the ranks to become Chief of the Astronaut Office in 1963. Alan Shepard, an American to the end, passed away in California."
        },
        "Id3": {
            "text": "Alan Shepard was born in the US, in the state of New Hampshire, in November 1923. He served as the Chief of the Astronaut Office in 1963, six years after graduating from NWC with an MA. He died in the state of California."
        }
