    "original_gold_lex_dicts": {
        "Id1": {
            "text": "A monument to the 11th Mississippi Infantry was erected in 2000 categorised as a contributing property and stands in the state of Pennsylvania in the municipality of Gettysburg in Pennsylvania located in Adams County, Pennsylvania. Carroll County Maryland is southeast and Pennsylvania's Cumberland County is to the north of the Adams County."
        },
        "Id2": {
            "text": "Categorised as a contributing Property, the 11th Mississippi Infantry Monument was established in 2000. It is located in Adams County in the municipality of Gettysburg in Pennsylvania. This county has Carroll County, Maryland to its southeast, and Cumberland county to its north."
        },
        "Id3": {
            "text": "The 11th Mississippi Infantry Monument, located in the municipality of Gettysburg in Adams County, Pennsylvania, which sits north of Carroll County, Maryland, and south of Cumberland County, was established in the year 2000 and falls under the category of Contributing property."
        }
    },
