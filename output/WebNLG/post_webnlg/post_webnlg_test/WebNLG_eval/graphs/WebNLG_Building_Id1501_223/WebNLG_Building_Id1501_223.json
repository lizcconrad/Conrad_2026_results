    "original_gold_lex_dicts": {
        "Id1": {
            "text": "Alan B. Miller Hall, located at 101 Ukrop Way in Virginia, currently housing the Mason School of Business, was designed by Robert A.M. Stern (building start date: March 30, 2007) and is owned by the College of William and Mary (chancellor: Robert Gates)."
        },
        "Id2": {
            "text": "The Mason School of Business are the current tenants of Alan B Miller Hall at 101 Ukrop Way, which was designed by Robert A M Stern and is situated in Virginia. The building is owned by The College of William and Mary whose chancellor is Robert Gates. The building began construction on 30/03/2007."
        },
        "Id3": {
            "text": "Alan B. Miller Hall, located at 101 Ukrop Way in Virginia and designed by Robert A.M. Stern with a project start date of March 30, 2007, is currently occupied by the Mason School of Business and owned by the College of William and Mary (chancellor: Robert Gates)."
        }
    },
