    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The Mason School of Business is located in the United States at the Alan B Miller Hall which is owned by The College of William and Mary. The hall is located at 101 Ukrop Way and its build began on the 30th of March, 2007 after being designed by architect Robert A M Stern."
        },
        "Id2": {
            "text": "Designed by Robert Stern and located at 101 Ukrop Way the Alan B. Miller Hall building was commenced on 30 March of 2007. Currently tenanted by the Mason School of Business and owned by the College of William and Mary, the building is located in the United States."
        },
        "Id3": {
            "text": "Construction of the Alan B. Miller Hall began on March 30th, 2007. The building's architect is Robert A. M. Stern, and it is owned by the College of William and Mary. The Alan B. Miller Hall is located at 101 Ukrop Way, in the United States, and the current tenant is the Mason School of Business."
        }
