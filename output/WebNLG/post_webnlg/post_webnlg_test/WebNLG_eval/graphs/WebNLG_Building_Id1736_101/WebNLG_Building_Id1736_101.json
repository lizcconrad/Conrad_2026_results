    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The Mason School of Business is located in the United States at the College of William and Mary owned Alan B. Miller Hall, which was designed by architect Robert A.M. Stern. The hall, which was completed on the 1st of June, 2009, can be found at 101 Ukrop Way and began construction on the 30th of March, 2007."
        },
        "Id2": {
            "text": "The architect of the Alan B Miller Hall, which is at 101 Ukrop Way, USA, is Robert A M Stern. They started to build the Alan B Miller Hall on the 30th of March, 2007 and it was finished on the 1st of June 2009.The Mason School of Business are the current tenants of the building which is owned by The College of William and Mary."
        },
        "Id3": {
            "text": "The College of William and Mary own the Alan B. Miller Hall situated at 101 Ukrop Way, USA. The building, which was designed by architect Robert A.M. Stern, currently houses The Mason School of Business and was constructed between the 30th of March 2007 and the 1st of June 2009."
        }
    },
