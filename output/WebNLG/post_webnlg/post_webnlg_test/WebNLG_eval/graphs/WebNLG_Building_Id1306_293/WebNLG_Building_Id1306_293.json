    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The Mason School of Business are the current tenants of Alan B Miller Hall which is situated in Virginia at 101 Ukrop Way. The architect of the Alan B Miller Hall was Robert A M Stern and the building began construction on the 30th of March 2007. The Mason School of Business is a tenant of the hall and The College of William and Mary own it."
        },
        "Id2": {
            "text": "Designed by Robert A.M. Stern, with construction beginning March 30, 2007, Alan B. Miller Hall is located at 101 Ukrop Way in Virginia, is owned by the College of William and Mary, and currently houses the Mason School of Business as tenants."
        },
        "Id3": {
            "text": "The College of William and Mary's Alan B. Miller Hall was designed by Robert A.M. stern, and its construction began on March 30, 2007. The building, located at 101 Ukrop Way on their Virginia campus, is used by the Mason School of Business."
        }
    },
