    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The compilation album Andy Warhol's Velvet Underground Featuring Nico was followed by The Velvet Underground album Squeeze, which was followed by The Bootleg Series Volume 1: The Quine Tapes, recorded through Polydor Records in London."
        },
        "Id2": {
            "text": "The Bootleg Series Volume I: The Quine Tapes released by Polydor Records ( London) was preceded by the album Squeeze which itself was preceded by the album Andy Warhol's Velvet Underground Featuring Nico."
        },
        "Id3": {
            "text": "The Velvet Underground made the album called \u201cAndy Warhol's Velvet Underground Featuring Nico\u201d then Squeeze then Bootleg Series Volume 1: The Quine Tapes. The latter was recorded under the Polydor Records record label in London."
        }
