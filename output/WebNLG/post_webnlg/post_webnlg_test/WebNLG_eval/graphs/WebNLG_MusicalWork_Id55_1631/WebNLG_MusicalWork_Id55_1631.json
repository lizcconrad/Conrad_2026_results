    "original_gold_lex_dicts": {
        "Id1": {
            "text": "Train's hit Mermaid was put out by the Sony Music Entertainment record label, was written by Amund Bj\u00f8rklund with the producer Stargate. Train followed Mermaid with Imagine, a song by John Lennon where Mermaid was produced by the Espionage production team."
        },
        "Id2": {
            "text": "The song Mermaid, by Train, is a Sony Music Entertainment release produced by Stargate along with the production team Espionage. Mermaid, written by Amund Bjorklund, is followed by John Lennon's Imagine."
        },
        "Id3": {
            "text": "The Train song Mermaid written by Amund Bj\u00f8rklund and production team Stargate was produced by the production team Espionage and released under the record label Sony Music Entertainment. It was followed by the release of Imagine by John Lennon performed by Train."
        }
    },
