    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The 11th Mississippi Infantry Monument was established in 2000 and its location is Adams County, Pennsylvania. The 11th Mississippi Infantry Monument is categorized as a Contributing Property. Franklin County, PA, is to the west of it, Cumberland County, PA, is to the north, and Carroll County, Maryland, is to the southeast."
        },
        "Id2": {
            "text": "The 11th Mississippi Infantry Monument established in the year 2000, located in Adams County, Pennsylvania falls under the category of Contributing property. Adams County Pennsylvania is East of Franklin County, Pennsylvania and has Cumberland County, Pennsylvania to its north and Carroll County, Maryland to its southeast."
        },
        "Id3": {
            "text": "A monument to the 11th Mississippi Infantry, categorised as a contributing property, was erected in 2000 and stands in the state of Pennsylvania located in Adams County. Pennsylvania's Franklin County is found to the west of Adams County. Carroll County, Maryland, is southeast Pennsylvania's Adams County, and Cumberland County is to the north of the Adams County."
        }
    },
