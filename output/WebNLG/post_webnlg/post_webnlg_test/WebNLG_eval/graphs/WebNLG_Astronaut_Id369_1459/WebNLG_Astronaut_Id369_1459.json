        "Id1": {
            "text": "Alan Shepard was born in New Hampshire, United States, on November 18th, 1923. He was selected by NASA in 1959. He was also awarded the Distinguished Service Medal by the United States Navy. Shepard died in California."
        },
        "Id2": {
            "text": "Alan Shepard was an American who was born on November 18, 1923 in New Hampshire. Shepard was awarded the Distinguished Service Medal in the United States Navy, selected by NASA in 1959 and died in California."
        },
