    "original_gold_lex_dicts": {
        "Id1": {
            "text": "The Train song Mermaid (a song on Train's \"California 37\" album) was written by Espen Lind and Amund Bj\u00f8rklund.Train followed Mermaid with Imagine, a song by John Lennon but was produced by the Espionage production team in the digital format."
        },
        "Id2": {
            "text": "The song performed by the band, Train, titled Mermaid, was written by Espen Lind and Amund Bjorklund and procured by Espionage. Mermaid was from Train's album California 37 and was distributed in a digital format. The song, Mermaid, was followed by the realease of the cover song, Imagine which was originally by John Lennon."
        },
        "Id3": {
            "text": "The song Mermaid by the band Train was produced by Espionage and written by Espen Lind and Amund Bjorklund. Mermaid is on the album California 37 which was distributed digitally and also includes John Lennon's song Imagine."
        }
    },
