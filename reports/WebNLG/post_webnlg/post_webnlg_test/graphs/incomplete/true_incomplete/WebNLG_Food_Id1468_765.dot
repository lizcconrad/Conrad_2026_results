strict digraph {
Mexico [lexicon_key=Mexico];
Mexican_peso [lexicon_key="Mexican_peso"];
Bionico [lexicon_key=Bionico];
Dessert [lexicon_key=Dessert];
Guadalajara [lexicon_key=Guadalajara];
Mexico -> Mexican_peso [label=currency, lexicon_key=currency];
Bionico -> Dessert [label=course, lexicon_key=course];
Bionico -> Guadalajara [label=region, lexicon_key=region];
Bionico -> Mexico [label=country, lexicon_key=country];
}
